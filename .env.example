# GitHub API (repos e perfil — inclui privados com escopo repo)
VITE_GITHUB_ACCESS_TOKEN=

# EmailJS (formulario de contato)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Search Console (meta tag de verificacao de propriedade)
VITE_GOOGLE_SITE_VERIFICATION=

# Linkedin Posts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry — vazio desliga a captura. Só envia em build de produção.
VITE_SENTRY_DSN=
# Upload de source maps no build (secreto: só na Vercel, nunca no repositório).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=portifolio
