{
  "name": "portifolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "git pull && yarn && vite",
    "build": "tsc -b && tsx scripts/generate-icon.ts && tsx scripts/generate-og.ts && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "fix": "yarn lint && tsc -b",
    "preview": "vite preview",
    "lhci": "lhci autorun",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@sentry/react": "^11",
    "@emotion/react": "^11.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "satori": "0.63.2",
    "@vieira/analytics": "file:./vendor/vieira-analytics",
    "@vieira/institucional": "file:./vendor/vieira-institucional",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.6",
    "npm": "^12.2.1",
    "react": "^18.3.1",
    "react-animated-cursor": "^2.11.2",
    "react-awesome-reveal": "^4.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.4",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@sentry/vite-plugin": "^4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
